model {
  repo = system 'Git repository (main)' {
    description 'Authored. The GitHub repository whose main branch holds the code and the k8s manifests that Flux reconciles.'
  }

  ci = system 'GitHub Actions' {
    description 'Three workflows push images to Docker Hub: deploy.yml for the app image, backup-image.yml for the backup job image, and architecture-site.yml for the architecture site image.'
    metadata {
      source '.github/workflows/deploy.yml'
    }
  }

  dockerhub = external 'Docker Hub' {
    description 'Authored. Registry that holds the app image repositories, the backup job image repository and the architecture site image repository. The workflows push to it and the cluster pulls from it.'
    metadata {
      source '.github/workflows/deploy.yml'
    }
  }

  flux = system 'Flux' {
    description 'GitOps controllers in flux-system that apply the manifests, scan the registry for new image tags and commit the tag bump back to main.'
    metadata {
      workload [
        'Deployment/source-controller',
        'Deployment/kustomize-controller',
        'Deployment/helm-controller',
        'Deployment/notification-controller',
        'Deployment/image-reflector-controller',
        'Deployment/image-automation-controller'
      ]
    }
  }

  archsite = system 'Architecture site' {
    description 'The static LikeC4 build of this model, served by nginx behind Traefik.'
    metadata {
      workload 'Deployment/architecture-site'
      source 'k8s/base/architecture-site/architecture-site.yaml'
    }
  }

  repo -[async]-> ci 'push to main starts deploy.yml, architecture-site.yml and backup-image.yml, each for the paths it watches'
  ci -[sync]-> dockerhub 'push the app, backup and site images'
  flux -[sync]-> dockerhub 'scan image tags'
  flux -[sync]-> repo 'Git over SSH: pull, commit tag bumps'
  flux -[sync]-> kanban 'apply the app overlays'
  kanban -[sync]-> dockerhub 'image pull'
  flux -[sync]-> archsite 'apply the architecture overlay'
  archsite -[sync]-> dockerhub 'image pull'
}

deployment {
  github = provider 'GitHub (SaaS)' {
    instanceOf repo

    runner = server 'GitHub-hosted runner (x86_64)' {
      description 'The runner architecture is read from a workflow run log, where the Java toolchain path ends in x64.'
      technology 'x86_64'
      instanceOf ci
    }
  }

  docker-hub = provider 'Docker Hub (SaaS)' {
    instanceOf dockerhub
  }

  extend netcup.k3s.flux-system {
    instanceOf flux
  }
}
