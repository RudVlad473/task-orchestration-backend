specification {
  element actor {
    style {
      shape person
      color muted
    }
  }
  element system
  element container
  element component
  element thread {
    notation 'Thread / executor'
    style {
      color amber
    }
  }
  element job {
    notation 'Run-to-completion job'
    style {
      color secondary
    }
  }
  element external {
    notation 'Outside this repository'
    style {
      color muted
    }
  }
  element note {
    notation 'Note, not a runtime element'
    style {
      shape document
    }
  }
  element datastore {
    style {
      shape cylinder
      color green
    }
  }
  element table {
    style {
      shape storage
      color green
      size small
    }
  }
  element topic {
    style {
      shape queue
      color indigo
    }
  }

  deploymentNode server
  deploymentNode cluster
  deploymentNode namespace
  deploymentNode provider

  relationship sync {
    line solid
  }
  relationship async {
    line dashed
    head open
  }
  relationship fk {
    notation 'Foreign key, child to parent'
    line dotted
    head diamond
  }
  relationship imports {
    notation 'Package imports another package'
    line dotted
    head vee
    color slate
  }

  tag generated
  tag planned

  tag logical
  tag process
  tag development
  tag physical
  tag scenarios
}
