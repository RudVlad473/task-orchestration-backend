model {
  client = actor 'Browser / API client' {
    description 'Holds a JSESSIONID cookie after signin.'
  }

  traefik = system 'Traefik' {
    description 'Public edge that terminates TLS and routes to the app by host.'
    metadata {
      source 'k8s/platform/traefik'
      host [
        'kanban-board-rud-vlad-473.duckdns.org',
        'kanban-board-rud-vlad-473-nonprod.duckdns.org',
        'kanban-board-rud-vlad-473-monitoring.duckdns.org',
        'kanban-board-rud-vlad-473-architecture.duckdns.org'
      ]
    }
  }

  kanban = system 'Kanban backend' {
    description 'Spring Boot REST API with session auth and per-user ownership checks.'
    metadata {
      workload 'Deployment/app'
    }

    api = container 'REST API' {
      technology 'Spring MVC, Tomcat request threads'
      description 'Serves signin, signup and the board, column, task and subtask routes. The 401, 403, 400 and 409 answers each come from a distinct layer.'
      metadata {
        source 'src/main/java/com/vrudenko/kanban_board/controller'
      }
    }

    publisher = thread 'kafka-publish executor' {
      technology 'Spring ThreadPoolTaskExecutor, bounded pool'
      description 'Publishes the Avro events of committed board, column, task and subtask mutations. The AFTER_COMMIT listener only submits to this pool, so the request thread does not wait on Kafka.'
      metadata {
        source 'src/main/java/com/vrudenko/kanban_board/config/AsyncConfig.java'
      }
    }

    consumer = thread 'activity-log consumer' {
      technology 'Spring Kafka listener, group activity-log'
      description 'Inserts each event into activity_log once, idempotent on event_id. After its retries, it sends a failed event to the dead-letter topic.'
      metadata {
        source 'src/main/java/com/vrudenko/kanban_board/activitylog'
      }
    }

    management = container 'Management server' {
      technology 'Spring Boot actuator'
      description 'Unrouted port that serves the health probes and the Prometheus endpoint.'
      metadata {
        source 'src/main/resources/application.properties'
      }
    }

    init = job 'register-schemas' {
      technology 'init container'
      description 'Registers each Avro record schema under its full name and sets BACKWARD compatibility before the app container starts.'
      metadata {
        source 'k8s/base/app/app.yaml'
      }
    }
  }

  postgres = datastore 'Postgres 16' {
    description 'Single instance in ns kanban-data, holding the prod and nonprod databases.'
    metadata {
      source 'k8s/data/postgres/postgres.yaml'
      workload 'StatefulSet/postgres'
    }

    spring_session = table 'spring_session' {
      technology 'Spring Session JDBC'
      description 'Authored. Spring Session creates this table at startup (initialize-schema=always), outside Flyway.'
      metadata {
        source 'src/main/resources/application.properties'
      }
    }
    spring_session_attributes = table 'spring_session_attributes' {
      technology 'Spring Session JDBC'
      description 'Authored. Spring Session creates this table at startup (initialize-schema=always), outside Flyway.'
      metadata {
        source 'src/main/resources/application.properties'
      }
    }

    activity_log_note = note 'activity_log: no foreign key, unique event_id' {
      description 'Authored. board_id is a plain column with no REFERENCES clause, and the unique event_id is the idempotency key the consumer relies on.'
      metadata {
        source 'src/main/resources/db/migration/V3__add_activity_log.sql'
      }
    }
  }

  avro_subjects = note 'Avro subjects' {
    description 'Authored. One subject per Avro record, named by its full name, registered by the init job and only looked up by the producer.'
    metadata {
      source 'src/main/avro'
    }
  }

  b2 = external 'Off-cluster backup bucket' {
    description 'Authored. Object storage outside the cluster whose key can write but not read or delete.'
    metadata {
      source 'k8s/data/postgres/backup/postgres-backup.sh'
    }
  }

  backup = job 'Postgres backup' {
    description 'CronJob that runs postgres-backup.sh as the prod DB role.'
    metadata {
      source 'k8s/data/postgres/backup-cronjob.yaml'
      workload 'CronJob/postgres-backup'
    }
  }

  redpanda = system 'Redpanda' {
    description 'Kafka-compatible broker, one per environment.'
    metadata {
      source 'k8s/base/redpanda/redpanda.yaml'
      workload 'StatefulSet/redpanda'
    }

    registry = component 'Schema Registry' {
      description 'Redpanda built-in registry that holds the Avro schemas and their compatibility setting.'
      metadata {
        source 'k8s/base/redpanda/redpanda.yaml'
      }
    }
    activity = topic 'kanban.activity' {
      description 'Carries the Avro events, keyed by event id.'
    }
    dlt = topic 'kanban.activity.dlt' {
      description 'Dead-letter topic for events the consumer still failed to process after its retries.'
    }
  }

  // --- relationships: runtime facts, not class calls ---
  backup -[sync]-> postgres 'pg_dump over the Postgres protocol'
  client -[sync]-> traefik 'HTTPS :443'
  traefik -[sync]-> kanban.api 'HTTP :8080'
  traefik -[sync]-> archsite 'HTTP :8080'
  kanban.api -[sync]-> postgres 'SQL over JDBC'
  kanban.api -[async]-> kanban.publisher 'AFTER_COMMIT hand-off'
  kanban.publisher -[async]-> redpanda.activity 'Kafka protocol and Schema Registry API'
  redpanda.activity -[async]-> kanban.consumer 'poll, group activity-log'
  kanban.consumer -[sync]-> postgres 'SQL over JDBC'
  kanban.consumer -[async]-> redpanda.dlt 'Kafka protocol and Schema Registry API'
  kanban.init -[sync]-> redpanda.registry 'Kafka protocol and Schema Registry API'
  kanban.publisher -[sync]-> redpanda.registry 'Kafka protocol and Schema Registry API'
  kanban.consumer -[sync]-> redpanda.registry 'Kafka protocol and Schema Registry API'
  backup -[sync]-> b2 'age-encrypted dump, S3 put'

  // Authored foreign key: Spring Session's own schema (schema-postgresql.sql in spring-session-jdbc 3.5.7).
  postgres.spring_session_attributes -[fk]-> postgres.spring_session 'session_primary_id'
}
