model {
  prometheus = system 'Prometheus' {
    description 'Metrics store and scraper. Its scrape edges come from the repo\'s PodMonitor and ServiceMonitor settings and the default monitors of its chart, not from live targets. It also scrapes itself, which is not drawn.'
    metadata {
      source 'k8s/monitoring/controllers/kube-prometheus-stack.yaml'
      workload 'HelmRelease/kube-prometheus-stack'
    }
  }

  grafana = system 'Grafana' {
    description 'Dashboards over the Prometheus and Loki datasources.'
    metadata {
      source 'k8s/monitoring/controllers/kube-prometheus-stack.yaml'
      workload 'HelmRelease/kube-prometheus-stack'
    }
  }

  node-exporter = system 'node-exporter' {
    description 'Host-level metrics exporter that runs on the node.'
    metadata {
      source 'k8s/monitoring/controllers/kube-prometheus-stack.yaml'
      workload 'HelmRelease/kube-prometheus-stack'
    }
  }

  loki = datastore 'Loki' {
    description 'Log store that runs as a single binary on a filesystem volume.'
    metadata {
      source 'k8s/monitoring/controllers/loki.yaml'
      workload 'HelmRelease/loki'
    }
  }

  alloy = system 'Alloy' {
    description 'Log collector that ships pod logs to Loki.'
    metadata {
      source 'k8s/monitoring/controllers/alloy.yaml'
      workload 'HelmRelease/alloy'
    }
  }

  postgres-exporter = system 'postgres-exporter' {
    description 'Exposes Postgres statistics as Prometheus metrics.'
    metadata {
      source 'k8s/monitoring/controllers/postgres-exporter.yaml'
      workload 'HelmRelease/postgres-exporter'
    }
  }

  kube-state-metrics = system 'kube-state-metrics' {
    description 'Exposes the state of Kubernetes objects as metrics. It is a subchart of the kube-prometheus-stack release.'
    metadata {
      source 'k8s/monitoring/controllers/kube-prometheus-stack.yaml'
      workload 'HelmRelease/kube-prometheus-stack'
    }
  }

  prometheus-operator = system 'Prometheus Operator' {
    description 'Reconciles the Prometheus, ServiceMonitor and PodMonitor objects of the kube-prometheus-stack release.'
    metadata {
      source 'k8s/monitoring/controllers/kube-prometheus-stack.yaml'
      workload 'HelmRelease/kube-prometheus-stack'
    }
  }

  kubelet = system 'kubelet (with cAdvisor)' {
    description 'Authored. The node agent and its built-in cAdvisor run inside the k3s server process that infra/vm/k3s/install.sh installs. No manifest in the repo declares them.'
    metadata {
      source 'infra/vm/k3s/config.yaml'
    }
  }

  kube-apiserver = system 'Kubernetes API server' {
    description 'Authored. The API server runs inside the k3s server process that infra/vm/k3s/install.sh installs. No manifest in the repo declares it.'
    metadata {
      source 'infra/vm/k3s/config.yaml'
    }
  }

  coredns = system 'CoreDNS' {
    description 'Authored. The cluster DNS that k3s deploys in kube-system. infra/vm/k3s/config.yaml leaves it on, because its disable list names only metrics-server. No manifest in the repo declares it.'
    metadata {
      source 'infra/vm/k3s/config.yaml'
    }
  }

  prometheus -[sync]-> node-exporter 'scrape metrics'
  prometheus -[sync]-> postgres-exporter 'scrape metrics'
  prometheus -[sync]-> certmanager 'scrape metrics'
  prometheus -[sync]-> kanban.management 'scrape metrics'
  prometheus -[sync]-> redpanda 'scrape metrics'
  prometheus -[sync]-> kubelet 'scrape kubelet, cAdvisor and probe metrics over HTTPS'
  prometheus -[sync]-> kube-apiserver 'scrape API server metrics'
  prometheus -[sync]-> coredns 'scrape DNS metrics on port 9153'
  prometheus -[sync]-> kube-state-metrics 'scrape cluster object state metrics'
  prometheus -[sync]-> prometheus-operator 'scrape operator metrics'
  prometheus -[sync]-> grafana 'scrape Grafana server metrics'
  postgres-exporter -[sync]-> postgres 'read statistics over SQL'
  grafana -[sync]-> prometheus 'PromQL queries'
  grafana -[sync]-> loki 'LogQL queries'
  alloy -[sync]-> loki 'push pod logs'
}

deployment {
  extend netcup.k3s.monitoring {
    instanceOf prometheus
    instanceOf grafana
    instanceOf node-exporter
    instanceOf loki
    instanceOf alloy
    instanceOf postgres-exporter
    instanceOf kube-state-metrics
    instanceOf prometheus-operator
  }

  extend netcup.k3s {
    instanceOf kubelet
    instanceOf kube-apiserver
  }

  extend netcup.k3s.kube-system {
    instanceOf coredns
  }
}

views '4 Physical' {
  deployment view monitoring {
    #physical
    order 3
    title 'Physical view: the monitoring stack and what it scrapes'
    description 'The scrape and query edges come from the PodMonitor, ServiceMonitor and datasource settings in the repo and from the default monitors of kube-prometheus-stack at the pinned version 91.5.2 that the values file leaves on. The check proves each HelmRelease exists and lands in monitoring, not what its chart renders. The kubelet, the API server and CoreDNS are authored, and the live target list is not read.'
    include
      netcup, netcup.k3s,
      netcup.k3s.monitoring.*,
      netcup.k3s.cert-manager.*,
      netcup.k3s.data.postgres,
      netcup.k3s.prod.kanban, netcup.k3s.nonprod.kanban,
      netcup.k3s.prod.redpanda, netcup.k3s.nonprod.redpanda,
      netcup.k3s.kubelet, netcup.k3s.kube-apiserver, netcup.k3s.kube-system.coredns
    exclude
      netcup.k3s.prod.kanban -> netcup.k3s.data.postgres,
      netcup.k3s.nonprod.kanban -> netcup.k3s.data.postgres,
      netcup.k3s.prod.kanban <-> netcup.k3s.prod.redpanda,
      netcup.k3s.nonprod.kanban <-> netcup.k3s.nonprod.redpanda
  }
}
