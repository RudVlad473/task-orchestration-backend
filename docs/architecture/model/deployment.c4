deployment {
  netcup = server 'Netcup VPS (x86_64)' {
    description 'x86_64. KANBAN-INGRESS filter behind the Netcup Cloud Firewall.'
    technology 'x86_64'

    k3s = cluster 'k3s (single node)' {
      description 'Flux reconciles this cluster from the k8s directory of the repository.'

      kube-system = namespace 'kube-system' {
        instanceOf traefik
      }

      prod = namespace 'kanban-prod' {
        instanceOf kanban
        instanceOf redpanda
      }

      nonprod = namespace 'kanban-nonprod' {
        instanceOf kanban
        instanceOf redpanda
      }

      data = namespace 'kanban-data' {
        instanceOf postgres
        instanceOf backup
      }

      flux-system = namespace 'flux-system' {
      }

      cert-manager = namespace 'cert-manager' {
      }

      monitoring = namespace 'monitoring' {
      }

      architecture = namespace 'architecture' {
        instanceOf archsite
      }
    }
  }
}
