views {
  dynamic view signup-ok {
    #scenarios
    variant sequence
    title 'Scenario: signup succeeds'
    description 'POST /api/signup through to a session cookie. The body is validated, the email is checked for a duplicate and the user inserted, then the new account is authenticated in the same request: the user is read by id, the live sessions are read, and the security context is saved in a new session.'

    client -> traefik 'POST /api/signup {displayName, email, password}'
    traefik -> kanban.api 'forward, body validated before the handler'
    kanban.api -> postgres.table_users 'SELECT: is the email taken'
    kanban.api -> postgres.table_users 'INSERT user'
    kanban.api -> postgres.table_users 'SELECT user by id (authentication)'
    kanban.api -> postgres.spring_session 'read live sessions for the user'
    kanban.api -> postgres.spring_session 'save security context in the session'
    traefik <- kanban.api '201 Created, Set-Cookie JSESSIONID'
    client <- traefik '201 {id, email, displayName, theme}'
  }

  dynamic view error-401 {
    #scenarios
    variant sequence
    title 'Scenario: 401 with no session cookie'
    description 'A request to a protected route with no session cookie is answered 401 with code UNAUTHENTICATED by the authentication entry point, before any controller runs. No SQL step is drawn. Measured once before the fix at 82775fa (02-04-401-measure.txt, GET and POST /api/boards): a client asking for JSON got this 401 with no SQL, while a client whose Accept header did not name application/json (a bare wildcard, or a browser navigation header) had its refused request saved in a new session, one spring_session row and a JSESSIONID cookie per request. A header that names application/json alongside a wildcard was not saved. Since commit 17a94cb the main security chain saves no refused request. AuthorizationGatingTest checks GET and POST /boards in process (MockMvc) with four Accept variants for no new session row and no cookie; it failed 6 of 8 cases before the fix and passes after. After the fix it was observed at 7bccf71 (the same record, commit 2fbe8ff, a live run on GET and POST /api/boards) that, with JSON, wildcard, browser navigation, axios-style and absent Accept headers, and in a burst of 10 wildcard GETs, the 401 set no cookie and created no spring_session row, no statement appeared in the Postgres capture windows, and a real signin still created exactly one session row. Not observed: other routes and methods, a proxy in the path, Redpanda, a stale session cookie and TLS, all in one run on one machine; a statement outside the capture windows (one second after each request, plus one log-tail read after rows A to I; the whole log was not re-read).'

    client -> traefik 'GET /api/boards, no session cookie'
    traefik -> kanban.api 'forward'
    traefik <- kanban.api '401 UNAUTHENTICATED, answered by the entry point before any controller'
    client <- traefik '401 ProblemDetail, code UNAUTHENTICATED'
  }

  dynamic view error-403 {
    #scenarios
    variant sequence
    title 'Scenario: 403 on a board the caller does not own'
    description 'The caller is signed in, but the board in the path belongs to another user. The ownership check reads the user and the board, compares the owner, and refuses with code ACCESS_DENIED. The session lookup that authenticates the request is not drawn.'

    client -> traefik 'GET /api/boards/{boardId}/columns, board owned by another user'
    traefik -> kanban.api 'forward'
    kanban.api -> postgres.table_users 'SELECT user by id'
    kanban.api -> postgres.table_boards 'SELECT board by id'
    traefik <- kanban.api '403 ACCESS_DENIED, the board owner id differs from the caller'
    client <- traefik '403 ProblemDetail, code ACCESS_DENIED'
  }

  dynamic view error-409 {
    #scenarios
    variant sequence
    title 'Scenario: 409 on a stale task version'
    description 'A task update carries the version the client last read, and another request has changed the task since. The ownership chain (task, column, board, user) passes and the task is loaded, the version check fails, and the request ends with code OPTIMISTIC_LOCK_CONFLICT. Only the tasks table is drawn: the other ownership reads are named in the step title. Nothing is written and no activity event is published.'

    client -> traefik 'PUT /api/boards/{boardId}/columns/{columnId}/tasks/{taskId} {title, description, version}'
    traefik -> kanban.api 'forward'
    kanban.api -> postgres.table_tasks 'SELECT task, with the ownership reads of its column, board and user'
    traefik <- kanban.api '409 OPTIMISTIC_LOCK_CONFLICT, request version differs from the stored one, nothing written, no event published'
    client <- traefik '409 ProblemDetail, code OPTIMISTIC_LOCK_CONFLICT'
  }

  dynamic view activity-log-row {
    #scenarios
    variant sequence
    title 'Scenario: a committed mutation becomes an activity_log row'
    description 'Starts after the HTTP request: a task update has committed. The domain event is handed to the publish executor after commit, so the request never waits on Kafka, then it is sent keyed by event id, polled by the activity-log consumer group and inserted once, idempotent on event_id. The dead-letter path is not drawn.'

    kanban.api -> kanban.publisher 'task update committed: TaskUpdatedEvent handed off AFTER_COMMIT, the request does not wait on Kafka'
    kanban.publisher -> redpanda.activity 'send, Avro, keyed by event id'
    redpanda.activity -> kanban.consumer 'poll, group activity-log'
    kanban.consumer -> postgres.table_activity_log 'SELECT: is event_id already recorded'
    kanban.consumer -> postgres.table_activity_log 'INSERT activity_log row, the unique event_id backstops a race past the check'
  }
}
