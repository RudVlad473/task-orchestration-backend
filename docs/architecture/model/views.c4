views {
  view index {
    title 'System context'
    description 'Who talks to the backend, and what it depends on.'
    include client, traefik, kanban, postgres, redpanda
  }

  view process of kanban {
    #process
    title 'Process view: how a committed mutation becomes an activity_log row'
    description 'Thread and messaging boundaries. The request thread never waits on Kafka.'
    include
      client,
      kanban.api, kanban.publisher, kanban.consumer,
      postgres,
      redpanda.*

    include kanban.api -> postgres with {
      title 'JDBC: users, boards, columns, tasks, subtasks, spring_session, spring_session_attributes'
    }
    include kanban.publisher -> redpanda.activity with {
      title 'Avro, keyed by event id'
    }
    include kanban.consumer -> postgres with {
      title 'INSERT activity_log, idempotent on event_id'
    }
    include kanban.consumer -> redpanda.dlt with {
      title 'after retries'
    }
  }

  view data of postgres {
    #logical
    title 'Logical view: tables and the foreign keys that own them'
    description 'The tables tagged generated and every fk edge between them come from the Flyway migrations through sync.mjs. The two spring_session tables are authored: Spring Session creates them outside Flyway.'
    include postgres.*
  }

  view development of kanban {
    #development
    title 'Development view: top-level packages and the direction they import'
    description 'The components and the edges between them are generated from import statements by sync.mjs. Package cycles are reported by sync.mjs check and are never gated.'
    include kanban.* where kind is component
  }

  deployment view production {
    #physical
    title 'Physical view: what runs where'
    description 'Mapping of software to nodes. The VPS is x86_64.'
    include
      netcup, netcup.k3s,
      netcup.k3s.kube-system, netcup.k3s.kube-system.**,
      netcup.k3s.prod.**,
      netcup.k3s.nonprod.**,
      netcup.k3s.data.**,
      netcup.k3s.cert-manager.**
  }

  dynamic view signin-ok {
    #scenarios
    variant sequence
    title 'Scenario: signin succeeds'
    description 'POST /api/signin through to a session cookie. The signin reads the user by email, reads it again by id while the credentials are checked, reads the live sessions for the user, then rotates the session id and saves the security context.'

    client -> traefik 'POST /api/signin {email, password}'
    traefik -> kanban.api 'forward'
    kanban.api -> postgres.table_users 'SELECT user by email'
    kanban.api <- postgres.table_users 'row'
    kanban.api -> postgres.table_users 'SELECT user by id'
    kanban.api -> postgres.spring_session 'read live sessions for the user'
    kanban.api -> postgres.spring_session 'rotate session id, save security context'
    traefik <- kanban.api '200 Set-Cookie JSESSIONID'
    client <- traefik '200 {id, email, displayName, theme}'
  }

  dynamic view signin-bad-credentials {
    #scenarios
    variant sequence
    title 'Scenario: signin with bad credentials'
    description 'The unknown-email branch: no row for the email, so a 401 with code BAD_CREDENTIALS. A wrong password for a known email returns the identical body right after the SELECT user by id drawn in signin-ceiling, so its SQL is a prefix of that view and has no view of its own.'

    client -> traefik 'POST /api/signin {email, password}'
    traefik -> kanban.api 'forward'
    kanban.api -> postgres.table_users 'SELECT user by email'
    kanban.api <- postgres.table_users 'no row'
    traefik <- kanban.api '401 BAD_CREDENTIALS'
    client <- traefik '401 ProblemDetail, code BAD_CREDENTIALS'
  }

  dynamic view signin-ceiling {
    #scenarios
    variant sequence
    title 'Scenario: signin refused at the live-session ceiling'
    description 'The credentials are right, but the user already holds the maximum number of live sessions. The response is the same 401 body as bad credentials, on purpose, so a client cannot tell a valid password from a wrong one.'

    client -> traefik 'POST /api/signin {email, password}'
    traefik -> kanban.api 'forward'
    kanban.api -> postgres.table_users 'SELECT user by email'
    kanban.api <- postgres.table_users 'row'
    kanban.api -> postgres.table_users 'SELECT user by id'
    kanban.api -> postgres.spring_session 'read live sessions for the user'
    kanban.api <- postgres.spring_session 'ceiling reached'
    traefik <- kanban.api '401 BAD_CREDENTIALS'
    client <- traefik '401 ProblemDetail, code BAD_CREDENTIALS'
  }
}
